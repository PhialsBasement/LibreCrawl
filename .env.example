# LibreCrawl Docker Environment Configuration

# Host binding for the application
# - 127.0.0.1 = localhost only (local development)
# - 0.0.0.0 = all interfaces (production, accessible from network)
HOST_BINDING=127.0.0.1

# Local mode - enables auto-login with admin access, no rate limits
# Set to "true" for local development, "false" for production
LOCAL_MODE=false

# Disable user registrations
# Set to "true" to prevent new users from registering
# Useful for production environments where you only want existing users
REGISTRATION_DISABLED=true

# DANGEROUSLY SKIP AUTH
# Set to "true" to let anyone log in as any username with no password.
# The username is only used to keep per-user sessions separate.
# DO NOT enable on a public network or in production.
DANGEROUSLY_SKIP_AUTH=false

# Allowed email domain for login— only addresses ending in this domain can log in
ALLOWED_EMAIL_DOMAIN=yourcompany.com

# Email Configuration for verification emails
# SMTP server settings
SMTP_HOST=smtp.emailservice.com
SMTP_PORT=587
SMTP_USER=your-sending-account@yourcompany.com
SMTP_PASSWORD=your-app-password 
SMTP_FROM=noreply@yourcompany.com
SMTP_FROM_NAME=LibreCrawl

# Base URLs for email links (used to generate verification links)
MAIN_APP_URL=https://crawl.librecrawl.com
WORKSHOP_APP_URL=https://workshop.librecrawl.com

# Optional: enables AI-powered per-issue explanations in the Page Diagnostics plugin
# Supports OpenAI (OPENAI_API_KEY) or Anthropic (ANTHROPIC_API_KEY)
# Not required to ship — the plugin works with built-in knowledge base
OPENAI_API_KEY=sk-xxxxx
# ANTHROPIC_API_KEY=

# Azure DevOps integration — enables ticket creation from Page Diagnostics
# Tickets are created as Product Backlog Items (Scrum) assigned to the Scrum Master
# Generate a PAT at: dev.azure.com → avatar → Personal Access Tokens
# Required PAT scope: Work Items (Read & Write)
AZURE_DEVOPS_ORG=YourCompany
AZURE_DEVOPS_PAT=xxxxx
AZURE_DEVOPS_SM_EMAIL=name@yourcompany.com
AZURE_DEVOPS_PROCESS=Scrum